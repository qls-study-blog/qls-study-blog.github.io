## 核心源码 src/sales_report.py
```python
import pandas as pd
from openpyxl import Workbook
from openpyxl.utils.dataframe import dataframe_to_rows
import os

def clean_sales(df: pd.DataFrame) -> pd.DataFrame:
    """数据清洗：空值过滤、数量>0、全字段去重"""
    key_cols = ["日期", "销售员", "产品", "数量", "单价", "地区"]
    df = df.dropna(subset=key_cols)
    df = df[df["数量"] > 0]
    df = df.drop_duplicates()
    df["销售额"] = df["数量"] * df["单价"]
    return df

def build_stats(df_clean: pd.DataFrame):
    """生成三类统计数据"""
    by_salesman = df_clean.groupby("销售员")["销售额"].sum().reset_index()
    by_area = df_clean.groupby("地区")["销售额"].sum().reset_index()
    total = df_clean["销售额"].sum()
    overview = pd.DataFrame([{"月度销售总额": total}])
    return by_salesman, by_area, overview

def write_report(df_clean, by_salesman, by_area, overview, out_path):
    wb = Workbook()
    ws1 = wb.active
    ws1.title = "明细清洗后"
    for r in dataframe_to_rows(df_clean, index=False, header=True):
        ws1.append(r)

    ws2 = wb.create_sheet("按销售员")
    for r in dataframe_to_rows(by_salesman, index=False, header=True):
        ws2.append(r)

    ws3 = wb.create_sheet("按地区")
    for r in dataframe_to_rows(by_area, index=False, header=True):
        ws3.append(r)

    ws4 = wb.create_sheet("总览")
    for r in dataframe_to_rows(overview, index=False, header=True):
        ws4.append(r)
    wb.save(out_path)

def main(raw_path: str, out_path: str):
    if not os.path.exists(raw_path):
        raise FileNotFoundError(f"原始文件不存在：{raw_path}")
    df_raw = pd.read_excel(raw_path)
    if df_raw.empty:
        raise ValueError("原始文件为空，没有任何数据")
    df_clean = clean_sales(df_raw)
    if df_clean.empty:
        raise ValueError("清洗之后无有效销售数据")
    by_salesman, by_area, overview = build_stats(df_clean)
    write_report(df_clean, by_salesman, by_area, overview, out_path)
    print(f"报表生成成功：{out_path}")

if __name__ == "__main__":
    try:
        main("./data/sales_raw.xlsx", "./output/report.xlsx")
    except Exception as e:
        print(f"执行异常：{e}")
